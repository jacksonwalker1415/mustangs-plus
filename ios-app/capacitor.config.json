{
  "appId": "com.fanplatformdemo.smuplus",
  "appName": "SMU+",
  "webDir": "www",
  "backgroundColor": "#354CA1",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#354CA1",
    "preferredContentMode": "mobile",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#354CA1",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK"
    }
  }
}
